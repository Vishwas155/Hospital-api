{
  "name": "nearby-hospitals-api",
  "version": "1.0.0",
  "description": "Nearby hospitals API for India (OpenStreetMap + Google Maps via headless Chromium)",
  "main": "dist/index.js",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:dev": "tsx scripts/dev-db.ts",
    "import:osm": "node dist/osmImport.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "playwright": "1.55.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
